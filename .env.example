# Configuration Vatel Smart Canteen — Copier vers .env en local (NE JAMAIS COMMITER .env)
DEBUG=True
SECRET_KEY=remplacer-par-une-cle-secrete-aleatoire-longue
DATABASE_URL=sqlite:///db.sqlite3
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
TIME_ZONE=Africa/Abidjan

# Règles métier et valeurs de démonstration
RESERVATION_CUTOFF_HOUR=18
LOW_BALANCE_THRESHOLD=2000
WALLET_MAX_BALANCE=100000
TOPUP_AMOUNTS=1000,2000,5000,10000,20000
ANNUAL_PASS_PRICE=180000
SCHOOL_YEAR_LABEL=2026-2027
SCHOOL_YEAR_START=2026-09-01
SCHOOL_YEAR_END=2027-06-30
PICKUP_PAYMENT_ENABLED=True
MAX_EXTRA_PORTIONS=1
DELIVERY_ENABLED=True
DELIVERY_FEE=500
DEFAULT_DEBIT_FREQUENCY=DAILY
MAX_UNPAID_RESERVATIONS=2
BANK_TRANSFER_DETAILS=Banque Vatel Démo — IBAN CI00 0000 0000 0000 0000 0000 (fictif)

# Mot de passe des comptes de démonstration (commande seed_demo)
DEMO_PASSWORD=remplacer-par-un-mot-de-passe-de-demo
